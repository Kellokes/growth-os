# Senha do Postgres (só usada dentro da rede do Docker). Gere com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GOS_POSTGRES_PASSWORD=

# Ligado em produção (HTTPS pelo Caddy). Desligue só para testar local sem HTTPS.
GOS_COOKIE_SECURE=true
GOS_SESSION_HOURS=12

# IP do proxy em que o app confia para X-Forwarded-For (gateway do Docker quando o Caddy roda no host).
GOS_TRUSTED_PROXIES=172.17.0.1

# OpenRouter (opcional, para outras atividades)
GOS_OPENROUTER_API_KEY=
GOS_OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Etapa 2 (o deploy.sh preenche sozinho se faltar):
# token entre o app e o gateway do Docker; o shell da IA não enxerga.
GOS_GATEWAY_TOKEN=
# Valores do {$DOMAIN} etc. usados no Caddyfile, para a tela de Projetos mostrar os domínios.
GOS_CADDY_VARS=
# Caminho do Caddyfile no VPS (padrão /opt/takeone/Caddyfile).
# GOS_CADDYFILE_HOST=/opt/takeone/Caddyfile
# Token fine-grained do GitHub, só com os repos dos projetos (Contents e Pull requests: leitura e escrita).
# A IA usa para clonar, criar branch, dar push e abrir PR. Nunca faz merge.
GOS_GITHUB_TOKEN=
