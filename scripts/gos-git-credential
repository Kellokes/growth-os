#!/bin/sh
# Credential helper do git: entrega o token do GitHub só para github.com, lendo o arquivo
# de segredo do compose. O token nunca vai para variáveis de ambiente dos comandos.
[ "$1" = "get" ] || exit 0
host=""
while IFS='=' read -r k v; do
  [ -z "$k" ] && break
  [ "$k" = "host" ] && host="$v"
done
[ "$host" = "github.com" ] || exit 0
f="${GITHUB_TOKEN_FILE:-/tmp/gos-secrets/github_token}"
[ -s "$f" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(tr -d ' \r\n' < "$f")"
