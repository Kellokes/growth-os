#!/usr/bin/env python3
"""Pull requests no GitHub com o token restrito do Growth OS.

  gos-pr create DONO/REPO --head BRANCH [--base main] --title "..." [--body "..." | --body-file ARQ]
  gos-pr list DONO/REPO
  gos-pr view DONO/REPO NUMERO

Nunca faz merge: quem aprova e faz merge é o owner, no GitHub.
"""
import json
import os
import sys
import urllib.error
import urllib.request

TOKEN_FILE = os.environ.get("GITHUB_TOKEN_FILE", "/tmp/gos-secrets/github_token")
API = "https://api.github.com"
SELF_REPO = os.environ.get("GROWTH_OS_REPO", "Kellokes/growth-os")

# Arquivos que mudam deploy, permissões ou a política de segurança: o PR avisa para o owner revisar com calma.
SENSITIVE = (".github/", "scripts/", "deploy/", "Dockerfile", "docker-compose", "compose.y", "Caddyfile", ".env")
SENSITIVE_SELF = ("app/executor.py", "app/security.py", "app/agent.py", "app/providers/", "gateway/")


def sensitive_files(repo: str, files: list[str]) -> list[str]:
    marks = SENSITIVE + (SENSITIVE_SELF if repo.lower() == SELF_REPO.lower() else ())
    return [f for f in files if any(f.startswith(m) or ("/" + m) in f or f.split("/")[-1].startswith(m) for m in marks)]


def warning_for(repo: str, base: str, head: str) -> str:
    try:
        cmp = call("GET", f"/repos/{repo}/compare/{base}...{head}")
    except SystemExit:  # sem a comparação o PR sai sem o aviso, mas sai
        return ""
    hits = sensitive_files(repo, [f["filename"] for f in (cmp or {}).get("files") or []])
    if not hits:
        return ""
    lines = "\n".join(f"- `{f}`" for f in hits[:30])
    return ("> [!WARNING]\n> Este PR mexe em arquivos de deploy, permissões ou segurança. "
            "Revise com calma antes do merge.\n\n" + lines + "\n\n")


def token() -> str:
    try:
        t = open(TOKEN_FILE, encoding="utf-8").read().strip()
    except OSError:
        t = ""
    if not t:
        sys.exit("Token do GitHub não configurado no VPS (GOS_GITHUB_TOKEN no .env). Peça ao owner.")
    return t


def call(method: str, path: str, body: dict | None = None):
    req = urllib.request.Request(
        API + path, method=method, data=json.dumps(body).encode() if body else None,
        headers={"Authorization": f"Bearer {token()}", "Accept": "application/vnd.github+json",
                 "X-GitHub-Api-Version": "2022-11-28", "User-Agent": "growth-os"},
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read() or b"null")
    except urllib.error.HTTPError as e:
        sys.exit(f"GitHub respondeu {e.code}: {e.read().decode(errors='replace')[:600]}")


def opt(args: list[str], name: str, default: str | None = None) -> str | None:
    if name in args:
        i = args.index(name)
        if i + 1 < len(args):
            return args[i + 1]
    return default


def main(argv: list[str]) -> None:
    if len(argv) < 2 or "/" not in argv[1]:
        sys.exit(__doc__.strip())
    cmd, repo, rest = argv[0], argv[1], argv[2:]
    if cmd == "list":
        for pr in call("GET", f"/repos/{repo}/pulls?state=open&per_page=30"):
            print(f"#{pr['number']}  {pr['head']['ref']} -> {pr['base']['ref']}  {pr['title']}  {pr['html_url']}")
    elif cmd == "view" and rest:
        pr = call("GET", f"/repos/{repo}/pulls/{int(rest[0])}")
        print(f"#{pr['number']} {pr['state']} mergeable={pr.get('mergeable')}  {pr['title']}\n{pr['html_url']}\n\n{pr.get('body') or ''}")
    elif cmd == "create":
        head, base, title = opt(rest, "--head"), opt(rest, "--base", "main"), opt(rest, "--title")
        if not head or not title:
            sys.exit("informe --head e --title")
        if head in ("main", "master", base):
            sys.exit("a branch do PR precisa ser diferente da principal")
        body = opt(rest, "--body", "")
        if opt(rest, "--body-file"):
            body = open(opt(rest, "--body-file"), encoding="utf-8").read()
        body = warning_for(repo, base, head) + (body or "") + "\n\n---\n_Aberto pelo Growth OS_"
        pr = call("POST", f"/repos/{repo}/pulls", {"title": title, "head": head, "base": base, "body": body})
        print(f"PR #{pr['number']} aberto: {pr['html_url']}")
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
